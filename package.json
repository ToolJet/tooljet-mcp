{
  "name": "tooljet-mcp",
  "version": "0.8.0",
  "main": "index.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "test": "npm run check:datasource-catalog && npm run render:catalog && vitest run",
    "check:datasource-catalog": "node scripts/datasource-coverage.mjs --check",
    "generate:catalogs": "node scripts/generate-catalog.mjs && node scripts/generate-datasource-catalog.mjs && node scripts/generate-default-definitions.mjs",
    "generate:page-icons": "node scripts/generate-page-icons.mjs",
    "generate:skill": "node scripts/generate-skill.mjs && npm run render:catalog",
    "render:catalog": "npm run build && node scripts/render-component-catalog.mjs",
    "sync:skill": "node scripts/sync-skill.mjs --all",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "MCP server and app-builder skill for ToolJet: build and modify ToolJet apps end to end through governed tools.",
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/baggage-span-processor": "0.5.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "json5": "^2.2.3",
    "moment": "^2.31.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bundle",
    "skills",
    "data",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToolJet/tooljet-mcp.git"
  },
  "homepage": "https://github.com/ToolJet/tooljet-mcp#readme",
  "bugs": {
    "url": "https://github.com/ToolJet/tooljet-mcp/issues"
  }
}
