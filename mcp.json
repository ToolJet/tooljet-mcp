{
  "mcpServers": {
    "tooljet": {
      "command": "node",
      "args": [
        "./bundle/index.js"
      ],
      "cwd": ".",
      "env_vars": [
        "TOOLJET_URL",
        "TOOLJET_DEPLOYMENT_URL",
        "TOOLJET_PAT",
        "TOOLJET_PROFILE",
        "TOOLJET_AGENT",
        "TOOLJET_MCP_HOME",
        "TOOLJET_MCP_NO_AUTO_SETUP"
      ]
    }
  }
}
