TOOLJET_URL=http://localhost:3000
TOOLJET_APP_URL=http://localhost:8082
# Create a personal access token in the target ToolJet workspace's Access tokens settings.
TOOLJET_PAT=tj_pat_...
# Optional compatibility profile for older clients. Batch create tools accept one item and are the default.
# TOOLJET_INCLUDE_LEGACY_SINGULAR_TOOLS=true

# --- Remote/HTTP deployment only (see docker-compose.mcp.yml) ---
# MCP_TRANSPORT=http
# PORT=8787
# MCP_SHARED_TOKEN=change-me       # optional; enables gateway mode and its bearer-token gate
# TOOLJET_NETWORK=change-me        # required; `docker network ls` for the ToolJet stack's actual network name
# When ToolJet is the sibling container from docker-compose.mcp.yml, address it by service name, not localhost:
# TOOLJET_URL=http://tooljet:80
